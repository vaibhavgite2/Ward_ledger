# Backend (export in the shell that runs the pipeline / uvicorn). Everything works without a key:
# Claude is optional and every Claude path has a deterministic fallback.
ANTHROPIC_API_KEY=
# WL_DISABLE_CLAUDE=1          # force the deterministic fallbacks even when a key is set
# WL_AS_OF=2025-10-05          # "today" for the dataset (open issues, remaining budget)
# WL_MODEL_FAST=claude-haiku-5-5
# WL_MODEL_WRITER=claude-sonnet-5-5
# WL_CORS_ORIGINS=http://localhost:3000
# WL_INSTANCE_DIR=backend/instance   # uploads + media signing key (gitignored)
# WL_SECRET=                         # signing key for private media links; generated in WL_INSTANCE_DIR if unset
# WL_DEMO_PASSWORD=wardledger-demo   # password for  python -m live.seed --demo  accounts (demo only)
# E-mail (complaint resolved -> citizen, task past its deadline -> contractor). Unset = messages are only logged in email_outbox.
# WL_SMTP_HOST=smtp.example.com
# WL_SMTP_PORT=587
# WL_SMTP_USER=
# WL_SMTP_PASSWORD=
# WL_SMTP_SECURITY=starttls          # starttls | ssl | none
# WL_MAIL_FROM="The Ward Ledger <no-reply@yourdomain.example>"
# WL_APP_URL=http://localhost:3000   # base URL for links inside e-mails
# WL_OVERDUE_CHECK_MIN=15            # minutes between deadline checks (0 = off)

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
