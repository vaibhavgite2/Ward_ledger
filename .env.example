# Backend (export in the shell that runs the pipeline / uvicorn). Everything works without a key:
# Claude is optional and every Claude path has a deterministic fallback.
ANTHROPIC_API_KEY=
# WL_DISABLE_CLAUDE=1          # force the deterministic fallbacks even when a key is set
# WL_AS_OF=2025-10-05          # "today" for the dataset (open issues, remaining budget)
# WL_MODEL_FAST=claude-haiku-5-5
# WL_MODEL_WRITER=claude-sonnet-5-5
# WL_CORS_ORIGINS=http://localhost:3000

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
